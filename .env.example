# Copy to `.env.development` or `.env.local` for Vite.
# Values must be from the same Supabase project.
#
# Invitation / magic-link emails use your HOSTED project's URL settings (not this file):
# Dashboard → Authentication → URL Configuration → Site URL should match this app (e.g.
# http://localhost:5173 for Vite). Add the same origin under Redirect URLs. If Site URL is
# http://localhost:3000, links in emails will point at port 3000.
#
# If sign-up/login shows "Cannot reach Supabase":
# - Use Chrome/Edge at http://localhost:5173 (editor embedded browsers sometimes block API calls).
# - Or enable the dev proxy (below): browser only talks to localhost; Vite forwards to Supabase.
# - Dashboard → Settings → API: Project URL + anon key (JWT eyJ...) or publishable (sb_publishable_...).
# - Restart `npm run dev` after changing this file.

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Supabase "anon" / publishable key (not the service_role key).
VITE_SB_PUBLISHABLE_KEY=your_anon_key_here

# Dev-only: route API via Vite (fixes many "Failed to fetch" in embedded browsers / strict networks).
# Requires Node.js to resolve VITE_SUPABASE_BACKEND_URL (ENOTFOUND disables proxy automatically).
# VITE_SUPABASE_DEV_PROXY=true
# VITE_SUPABASE_BACKEND_URL=https://YOUR_PROJECT.supabase.co

# Optional
# VITE_GOOGLE_WORKPLACE_DOMAIN=
# VITE_DISABLE_EMAIL_PASSWORD_AUTHENTICATION=false
# VITE_INBOUND_EMAIL=
